# Copy this file to .env and fill in your real values. Never commit .env itself.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rice_pest_db
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
HTTPS_ONLY=false
# For direct production TLS set both paths; otherwise terminate TLS at a trusted proxy.
# SSL_CERTFILE=
# SSL_KEYFILE=
# TLS_TERMINATED_BY_PROXY=false
# FORWARDED_ALLOW_IPS=127.0.0.1
# Comma-separated production dashboard origins:
# CORS_ALLOWED_ORIGINS=https://dashboard.example.org

# Require an agriculturist / OPA to approve new accounts before they can use
# the app. Off until an approving office account exists.
REQUIRE_ACCOUNT_APPROVAL=false

# Timezone for months, quarters, "today" and date filters (farmers' local time).
# Default Asia/Manila; change only if the app is used elsewhere.
APP_TIMEZONE=Asia/Manila

# LAN discovery: the mobile app broadcasts on this UDP port to find the server
# on Wi-Fi, Ethernet or a hotspot without an IP address. Must match the app.
# DISCOVERY_PORT=8001
# DISCOVERY_ENABLED=true
